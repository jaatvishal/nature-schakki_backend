# Natures Chakki — Environment Variable Template
# Copy to .env for local development (gitignored)
# In production, use Azure App Service settings or Key Vault references

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# Database
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=NaturesChakki;User Id=sa;Password=Admin@123;TrustServerCertificate=True

# Redis (required when CacheProvider=Redis)
ConnectionStrings__Redis=localhost:6379

# Cache: Memory | Redis
CacheProvider=Memory

# Email (Gmail requires an app password; never commit real values)
Email__Provider=Smtp
Email__FromAddress=
Email__FromName=Nature's Chakki
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__Username=
Email__Smtp__Password=

# JWT
JwtSettings__Key=super_secret_development_key_at_least_32_chars
JwtSettings__Issuer=https://localhost:5001
JwtSettings__Audience=https://localhost:5001
JwtSettings__DurationInMinutes=60

# Stripe (use test keys from https://dashboard.stripe.com/test/apikeys)
StripeSettings__PublishableKey=pk_test_placeholder
StripeSettings__SecretKey=sk_test_placeholder
StripeSettings__WebhookSecret=whsec_placeholder

# Dev seed users (Development environment only)
SeedUsers__AdminEmail=admin@natureschakki.com
SeedUsers__AdminPassword=Admin@123!
SeedUsers__CustomerEmail=customer@natureschakki.com
SeedUsers__CustomerPassword=Customer@123!

# Serilog (optional overrides)
# Serilog__MinimumLevel__Default=Information

# Angular (client/.env or environment files)
# API_URL=https://localhost:5001/api
